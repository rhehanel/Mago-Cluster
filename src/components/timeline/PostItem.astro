---
import TimeDisplay from '../glob/TimeDisplay.astro';
import GlobalImage from '../GlobalImage.astro'; 

interface Props {
  item: any;
  targetUrl: string;
  timeData: any; 
}

const { item, targetUrl, timeData } = Astro.props;
const title = item.data.title;
---
<article class="timeline-item post-item col-span-4 md:col-span-8">
    <div class="title">
        <a href={targetUrl}>
            <h2>{title}</h2>
        </a>
        {timeData && <TimeDisplay timeData={timeData} />}
    </div>
    <a href={targetUrl}>
    {item.thumbnail && (
      <div class="thumb-wrap">
        {/* 💡 기본 img 태그 대신 GlobalImage 사용 */}
        <GlobalImage 
          src={item.thumbnail} 
          alt={title} 
          imgStyle={{ width: '100%', height: '100%', objectFit: 'cover' }} 
        />
      </div>
    )}
    </a>
    <div class="meta">
        <a href={targetUrl}>
            {item.excerpt && 
              <div class="excerpt">
                {item.excerpt
                  .replace(/\\(\r?\n)/g, '$1') // 줄 끝에 붙은 \ 제거
                  .replace(/\\$/, '')          // 글자 수 자르기로 맨 끝에 남은 \ 제거
                  .split(/\n{2,}/)             // 그냥 엔터(연 구분) 기준으로만 <p> 분리
                  .map((stanza: string) => (
                    <p>{stanza}</p>
                ))}
              </div>
            }
        </a>
    </div>
</article>