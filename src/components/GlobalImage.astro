---
// src/components/GlobalImage.astro
import { Image } from 'astro:assets';
import { getMediaUrl } from '../utils/media';

interface Props {
  src: any;
  alt?: string;
  imgStyle?: Record<string, any> | string;
  imgClass?: string;
}

const { src, alt = "Image", imgStyle, imgClass = "" } = Astro.props;

function resolveSrcInput(input: any): any {
  if (!input) return null;
  if (input instanceof Promise) return input;
  if (typeof input === 'string') return input;
  
  if (typeof input === 'object') {
    if (typeof input.src === 'string') return input.src;
    if (input.src && typeof input.src === 'object') return input.src;
    if (typeof input.image === 'string') return input.image;
    if (typeof input.url === 'string') return input.url;
    if (typeof input.value === 'string') return input.value;

    for (const key of Object.keys(input)) {
      const found = resolveSrcInput(input[key]);
      if (found) return found;
    }
  }
  return null;
}

let resolvedSrc = resolveSrcInput(src);
if (resolvedSrc instanceof Promise) {
  resolvedSrc = await resolvedSrc;
  resolvedSrc = resolveSrcInput(resolvedSrc);
}

const isString = typeof resolvedSrc === 'string';
const isObject = typeof resolvedSrc === 'object' && resolvedSrc !== null;

let finalImageSrc = ''; 
let finalAstroImage = null; 

if (isObject && 'src' in resolvedSrc) {
  finalAstroImage = resolvedSrc;
} else if (isString) {
  // 1. 배포 환경(PROD)이면서 외부 URL이 아닌 경우 -> R2 도메인(getMediaUrl) 사용
  if (import.meta.env.PROD) {
    finalImageSrc = getMediaUrl(resolvedSrc);
  } else {
    // 2. 로컬 개발 환경(DEV) -> 기존 로직대로 src/assets 또는 public 경로 렌더링
    const marker = 'assets/images';
    const idx = resolvedSrc.indexOf(marker);
    if (idx !== -1) {
      const relativePath = resolvedSrc.substring(idx + marker.length);
      const imagePath = `/src/assets/images${relativePath}`;
      const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/**/*.{jpeg,jpg,png,webp,avif}');
      const imageModule = images[imagePath];
      
      if (imageModule) {
        const mod = await imageModule();
        finalAstroImage = mod.default;
      } else {
        finalImageSrc = resolvedSrc; 
      }
    } else {
      finalImageSrc = resolvedSrc; 
    }
  }
}

const defaultStyle = { maxWidth: '100%', height: 'auto' };
const appliedStyle = imgStyle || defaultStyle;
---

{finalAstroImage ? (
  <Image src={finalAstroImage} alt={alt || "이미지"}
    widths={[400, 800, 1200]}
    sizes="(max-width: 768px) 100vw, 800px"
    format="webp"
    style={appliedStyle}
    class={imgClass}
    inferSize={true}/>
) : finalImageSrc ? (
  <img src={finalImageSrc} alt={alt || "이미지"} loading="lazy" style={appliedStyle} class={imgClass} />
) : (
  <div style="padding: 1rem; border: 1px dashed red; color: red;">
    ⚠️ 이미지를 불러올 수 없거나 경로가 비어있습니다. (받은 값: {JSON.stringify(src)?.slice(0, 100)})
  </div>
)}