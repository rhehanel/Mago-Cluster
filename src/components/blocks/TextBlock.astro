---
interface Props {
  title?: string;
  content?: string | { value?: string } | null;
}

const { title, content: rawContent } = Astro.props;
const html = (typeof rawContent === 'string' ? rawContent : rawContent?.value ?? '').trim();
---

{(title || html) && (
  <div class="text-block-wrapper">
    {title && <h3 class="text-block-title">{title}</h3>}
    {html && <article class="text-block rendered" set:html={html} />}
  </div>
)}

<style>
  .text-block.rendered :global(p:first-child) { margin-top: 0; }
  .text-block.rendered :global(p:last-child) { margin-bottom: 0; }
</style>