---
interface Props {
  link?: any;
  size?: number | string;
}

const props = Astro.props;

// 💡 어떤 복잡한 구조로 값이 들어와도 문자열(URL)을 정확히 추출하는 개선된 유틸리티
function extractRawUrl(input: any): string {
  if (!input) return '';
  if (typeof input === 'string') return input;
  
  // 객체인 경우 내부 속성들을 재귀적으로 탐색하거나 주요 키를 먼저 확인
  if (typeof input === 'object') {
    // 1. 직접적인 값 형태 확인
    if (typeof input.link === 'string') return input.link;
    if (typeof input.url === 'string') return input.url;
    if (typeof input.value === 'string') return input.value;

    // 2. 중첩된 객체 순회
    for (const key of Object.keys(input)) {
      const found = extractRawUrl(input[key]);
      if (found && typeof found === 'string' && (found.includes('youtube') || found.includes('youtu.be') || found.includes('vimeo') || found.includes('drive.google.com') || found.startsWith('http'))) {
        return found;
      }
    }
  }
  return '';
}

// 💡 props 전체 혹은 props.link 중 유효한 URL을 찾아냅니다.
const rawUrl = extractRawUrl(props.link) || extractRawUrl(props);

// 임베드 URL 자동 변환 함수
function getEmbedUrl(inputUrl: string): string {
  if (!inputUrl) return '';
  const cleanUrl = inputUrl.trim();

  // YouTube 파싱 (일반 watch, short link youtu.be, shorts, embed 모두 대응)
  const ytMatch = cleanUrl.match(/(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?v=|watch\?.+&v=|shorts\/))([\w-]{11})/);
  if (ytMatch && ytMatch[1]) {
    return `https://www.youtube.com/embed/${ytMatch[1]}`;
  }

  // Vimeo 파싱
  const vimeoMatch = cleanUrl.match(/(?:vimeo\.com\/|player\.vimeo\.com\/video\/)(\d+)/);
  if (vimeoMatch && vimeoMatch[1]) {
    return `https://player.vimeo.com/video/${vimeoMatch[1]}`;
  }

  // Google Drive 파싱
  const driveMatch = cleanUrl.match(/drive\.google\.com\/file\/d\/([^\/\?]+)/);
  if (driveMatch && driveMatch[1]) {
    return `https://drive.google.com/file/d/${driveMatch[1]}/preview`;
  }
  if (cleanUrl.includes('drive.google.com') && cleanUrl.includes('/view')) {
    return cleanUrl.replace(/\/view.*$/, '/preview');
  }

  // 이미 embed 형태이거나 일반 HTTP 링크인 경우
  if (cleanUrl.startsWith('http://') || cleanUrl.startsWith('https://')) {
    return cleanUrl;
  }

  return '';
}

const embedUrl = getEmbedUrl(rawUrl);

// 너비(size) 설정 반영 (기본값 100%)
const rawSize = props.size ?? '100%';
const containerWidth = typeof rawSize === 'number' ? `${rawSize}%` : rawSize;
---

<article class="video-player" style={`width: ${containerWidth};`}>
  {embedUrl ? (
    <div class="video-container">
      <iframe
        src={embedUrl}
        title="Video player"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
      ></iframe>
    </div>
  ) : (
    <div class="error-msg">
      ⚠️ Please enter a valid video URL. (Input was: {String(rawUrl || 'empty')})
    </div>
  )}
</article>

<style>
  .video-player {
    display: block;
    max-width: 100%;
  }
  .video-container {
    position: relative;
    padding-bottom: 56.25%; /* 16:9 비율 */
    height: 0;
    overflow: hidden;
    background-color: #000;
  }
  .video-container iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }
  .error-msg {
    padding: 1rem;
    font-size: 0.9rem;
    color: #7b0513;
    border: 1px solid #7b0513;
  }
</style>