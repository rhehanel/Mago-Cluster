---
import GlobalImage from '../GlobalImage.astro';

interface Props {
  columnImages?: any;
}

const props = Astro.props;
const data = props.columnImages?.columnImages ? props.columnImages.columnImages : (props.columnImages ?? props);

function extractString(input: any): string {
  if (!input) return '';
  if (typeof input === 'string') return input;
  if (typeof input === 'function' || typeof input !== 'object') return '';
  if (typeof input.link === 'string') return input.link;
  if (typeof input.url === 'string') return input.url;
  if (typeof input.value === 'string') return input.value;

  for (const key of Object.keys(input)) {
    const found = extractString(input[key]);
    if (found && typeof found === 'string' && !found.includes('native code')) return found;
  }
  return '';
}

const containerWidth = data?.containerWidth || '100%';

// 💡 스크롤 설정 및 조건부 높이 추출
const useScroll = data?.scrollable?.discriminant === true;
const containerHeight = useScroll ? (data?.scrollable?.value?.containerHeight || 'auto') : 'auto';

const rawImages = data?.images?.value || data?.images || [];
const images = Array.isArray(rawImages) ? rawImages : [];
---

<div 
  class={`column-images-container ${useScroll ? 'is-scrollable' : ''}`}
  style={{
    width: containerWidth,
    height: containerHeight,
    overflowY: useScroll ? 'scroll' : 'visible',
  }}>
  {images.map((item: any) => {
    const altText = item.alt || '';
    const showCaption = item.caption === true;
    const rawLink = extractString(item.link);
    const linkUrl = (rawLink.startsWith('http://') || rawLink.startsWith('https://') || rawLink.startsWith('/')) ? rawLink : '';

    const customImgStyle = {
      width: '100%',
      height: 'auto',
      display: 'block',
      objectFit: 'cover',
    };

    return (
      <div class="image-item" style={{ width: '100%' }}>
        {linkUrl ? (
          <a href={linkUrl} target="_blank" rel="noopener noreferrer" class="image-link">
            <GlobalImage src={item.image} alt={altText} imgStyle={customImgStyle} />
          </a>
        ) : (
          <GlobalImage src={item.image} alt={altText} imgStyle={customImgStyle} />
        )}
        {showCaption && altText && (
          <p class="image-caption">{altText}</p>
        )}
      </div>
    );
  })}
</div>

<style>
  .column-images-container {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    max-width: 100%;
  }

  .column-images-container.is-scrollable {
    border: 1px solid #7b0513;
    padding: 0.4rem;
    background: #d47979aa;
    scrollbar-color: auto;
    scrollbar-width: auto;
  }

  .column-images-container.is-scrollable::-webkit-scrollbar {
    width: 5px;
  }
  .column-images-container.is-scrollable::-webkit-scrollbar-track {
    background: transparent;
  }
  .column-images-container.is-scrollable::-webkit-scrollbar-thumb {
    border-radius: 5px;
    background-color: #7b0513;
  }

  .image-item {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .image-link {
    display: block;
    width: 100%;
  }

  .image-caption {
    font-size: 0.75rem;
    color: #7b0513;
    margin: 0;
    text-align: left;
  }
</style>