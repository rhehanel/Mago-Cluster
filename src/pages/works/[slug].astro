---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

import ImageWithLink from '../../components/ImageWithLink.astro';
import VideoPlayer from '../../components/VideoPlayer.astro';
import AsideAstroComponent from '../../components/Aside.astro';
import ManualList from '../../components/ManualList.astro';
import ColumnImages from '../../components/ColumnImages.astro';
import RowImages from '../../components/RowImages.astro';

export const prerender = true;

// 1. static path 생성
export async function getStaticPaths() {
  const works = await getCollection('works');
  return works.map(work => {
    const cleanSlug = work.id.replace(/\/index$/, '');
    return {
      params: { slug: cleanSlug },
      props: { work },
    };
  });
}

const { work } = Astro.props;
const { Content } = await render(work);

const originalTitle = work.data.originaltitle;
const title = work.data.title;

// --- 날짜 포맷 로직 ---
const timeField = work.data.time;
const primaryType = timeField?.discriminant;
const primaryData = timeField?.value || {};

function formatDate(dateInput: any) {
  if (!dateInput) return '';
  const date = new Date(dateInput);
  const year = date.getFullYear();
  const month = String(date.getMonth() + 1);
  const day = String(date.getDate()).padStart(2, '0');
  
  return `${year}. ${month}. ${day}`; 
}

let displayDate = '';
let displayTime = '';

if (primaryType === 'year') {
  displayDate = primaryData.value || '';
} else if (primaryType === 'date') {
  displayDate = formatDate(primaryData.value);
  displayTime = primaryData.time || '';
} else if (primaryType === 'time') {
  const isCustomDate = primaryData.discriminant === true;
  const secondaryData = primaryData.value || {};
  
  displayTime = secondaryData.time || '';
  if (isCustomDate) {
    displayDate = secondaryData.dates || '';
  } else {
    const startDate = formatDate(secondaryData.date);
    const endDate = formatDate(secondaryData.enddate);
    displayDate = (endDate && startDate !== endDate) ? `${startDate} ~ ${endDate}` : startDate;
  }
}

// 💡 블록 배열 가져오기
const blocks = work.data.blocks || [];

const markdocData = work.data.markdocSize;

const markCustom = markdocData?.discriminant;

let markdocWidth = '100%';
let markdocHeight ='max-content';

if (markCustom === true) {
  markdocWidth = markdocData.value?.width || '50%';
  markdocHeight = markdocData.value?.height || 'max-content';
}

const hasMarkdocBlock = blocks.some((block: any) => block.discriminant === 'markdoc');

---

<Layout title={title}>
  <div class="header">
    <section class="title">
      { originalTitle ? <h1>{ originalTitle }<br/>{title}</h1> : <h1>{ title }</h1> }
      { (displayDate || displayTime) && (
        <div class={displayTime ? "time-data flex" : "time-data"}>
          <span>☀︎</span>
          <span>
            { displayDate && <small>{ displayDate }</small> }
            { displayTime && <small>{ displayTime }</small> }
          </span>
        </div>
      )}
    </section>
    {!hasMarkdocBlock && (
      <section class="markdoc-content" style={{ width: markdocWidth }}>
        <div class="overflow-box" style={{ height: markdocHeight }}>
          <Content />
        </div>
      </section>
    )}
  </div>

  {/* 2. 하단 블록 리스트 출력 영역 */}
  {blocks.map((block: any) => {
    console.log('블럭:' + block);
    if (block.discriminant === 'video') {
      return ( <VideoPlayer link={block.value} /> );
    } else if (block.discriminant === 'image') {
      return <ImageWithLink image={block.value} />;
    } else if (block.discriminant === 'markdoc') {
      return (
        <section class="markdoc-content" style={{ width: markdocWidth }}>
          <div class="overflow-box" style={{ height: markdocHeight }}>
            <Content />
          </div>
        </section>
      );
    } else if (block.discriminant === 'manualList') {
      return <ManualList data={block.value} />;
    } else if (block.discriminant === 'columnImages') { 
      return <ColumnImages columnImages={block.value} />; 
    } else if (block.discriminant === 'rowImages') {
      return <RowImages rowImages={block.value} />;
    }
    return null;
  })}
</Layout>

<style is:global>

  #Content {
    display: flex;
    flex-wrap: wrap;
    padding: 0.4rem;
    gap: 0.4rem;
    justify-content: flex-start;
    align-items: flex-start;
    align-content: flex-start;
  }

  #Content > article {
    min-width: 10%;
    border:1px solid #7b0513;
  }

  header {
    width: min-content;
  }

  .header {
    max-width: min-content;
  }

  .title {
    width: max-content;
    max-width: 81.2rem;
    padding: 0.3rem 1rem 0.5rem 0.7rem;
    min-width: 30rem;
    border: 1px solid #7b0513;
    background: #7b0513ee;
    margin-bottom: 0.4rem;
    color:#d47979;
  }

  .title h1 {
    color:#d47979;
  }

  .title .time-data {
    display: flex;
    gap: 0.2rem;
    font-size: 0.7rem;
    color:#d47979;
  }

  .title .time-data small,
  .title .time-data span {
    display: block;
    font-size: 0.7rem;
  }

  .markdoc-content {
    background-color: rgb(212, 121, 121, 1);
    background:
    linear-gradient(rgb(212, 121, 121, 1),rgb(212, 121, 121, 1)) center/calc(100% - 20px) calc(100% - 20px) no-repeat,
    /*4 corners*/
    radial-gradient(circle at bottom left, rgb(212, 121, 121, 1) , rgb(212, 121, 121, 0) 60%) top right /10px 10px no-repeat,
    radial-gradient(circle at bottom right, rgb(212, 121, 121, 1) , rgb(212, 121, 121, 0) 60%) top left /10px 10px no-repeat,
    radial-gradient(circle at top right, rgb(212, 121, 121, 1) , rgb(212, 121, 121, 0) 60%) bottom left /10px 10px no-repeat,
    radial-gradient(circle at top left, rgb(212, 121, 121, 1) , rgb(212, 121, 121, 0) 60%) bottom right /10px 10px no-repeat,
    /*4 sides*/
    linear-gradient(to left, rgb(212, 121, 121, 0), rgb(212, 121, 121, 1)) right center/10px calc(100% - 20px) no-repeat,
    linear-gradient(to right, rgb(212, 121, 121, 0), rgb(212, 121, 121, 1)) left center/10px calc(100% - 20px) no-repeat,
    linear-gradient(to bottom, rgb(212, 121, 121, 0), rgb(212, 121, 121, 1)) top center/calc(100% - 20px)  10px no-repeat,
    linear-gradient(to top, rgb(212, 121, 121, 0), rgb(212, 121, 121, 1)) bottom center/calc(100% - 20px)  10px no-repeat;
  }

  .markdoc-content .overflow-box {
    max-width: 100%;
    overflow-y: scroll !important; 
    padding: 0.2rem 0.5rem 0.2rem 0.5rem;
    scrollbar-color: auto !important;
    scrollbar-width: auto !important;
  }

  .markdoc-content .overflow-box::-webkit-scrollbar {
    width: 5px;
    display: block !important;
  }

  .markdoc-content .overflow-box::-webkit-scrollbar-track {
    background: transparent; 
    border-radius: 5px;
  }

  .markdoc-content .overflow-box::-webkit-scrollbar-thumb {
    border-radius: 5px;
    background-color: #7b0513;
  }
</style>