le",["Map",11,12],"hanel-lee",{"id":11,"data":13,"filePath":15,"digest":16,"deferredRender":17},{"name":14},"Hanel Lee","src/content/people/Hanel Lee.mdoc","039c89b117a97c59",true,"scraps",["Map",20,21],"test",{"id":20,"data":22,"body":26,"filePath":27,"digest":28,"deferredRender":17},{"title":23,"slug":20,"tags":24,"time":25},"Test",[],["Date","2026-11-05T00:00:00.000Z"],"T\n\n{% VideoPlayer\n   url=\"https://www.youtube.com/watch?v=hXtvbnAaPbA\"\n   displayType=\"block\"\n   widthType=\"full\" /%}\n\nE\n\n{% CustomImage file=\"/images/scraps/test/mqdefault.jpg\" displayType=\"full\" /%}\n\nS\n\n{% ImageGallery\n   images=[{file: \"/images/scraps/test/839d5729da0ffb8d4958e20f86313523.webp\"}, {file: \"/images/scraps/test/dn28086-2_800.jpg\"}, {file: \"/images/scraps/test/QU_q-plFGd9TSPvGqW1XCEQQx7LPtfCQuq7ESH_QujsYx31iTu2JO6cHprEW67glp5NJLBQ04fsSm-SyDdOJaJNLRYhzZdRN8VBnZlaS-RzdFh5c3ezO0coGpSj5dF8TQBxvEj6K2Ld2p3CQo5YtLqTFyXgyLJQS3Z0Sih-7k0g.webp\"}]\n   align=\"right\"\n   flexAlign=\"flex-end\"\n   direction=\"column\"\n   displayType=\"inline\"\n   widthType=\"custom\"\n   customWidth=\"50%\" /%}\n\nT우울증은 증상이다 질병이다. 우울증의 원인이 외부에 있는 경우, 그것으로부터 벗어난다면 치료가 된다. 그러나 우울증의 원인이 자기 자신, 즉 현재의 자기 자신을 구성하게된, ‘나’를 만들었고 형성하는 경험과 시간들이 원인이 된다면 그것으로부터 벗어날수 없는 굴레에 갖힌다. 그것이 트라우마다. 트라우마로 구성된 자아는 끊임없이 자기 자신으로부터 벗어나게끔 한다. 내가 나라서, 나 자신이라는 감옥을 만들고 그곳에서 벗어나려 발버둥치다 끝내 포기한다. 나 자신이라는, 벗어날수 없는 감옥에서 무기력하게, 모든 것을 포기한채 웅크린 자세로 그것이 구원이든 파멸이든 이 상태의 마지막 순간, 끝을 기다린다. 산채로 죽는 것이다. 자살은 용기다. 나 자신이라는 감옥을 부술, 이 모든 것을 끝낼 용기와 의지가 도출해낸 행동의 결과다.","src/content/scraps/test.mdoc","c60903721f0153b5","tags",["Map",31,32,37,38,43,44,49,50,55,56,61,62,67,68,73,74,79,80,85,86,91,92,97,98,103,104,109,110,115,116,121,122,127,128],"archive",{"id":31,"data":33,"filePath":35,"digest":36},{"name":34},"Archive","src/content/tags/archive.yaml","96cbe3e8fc0c5c18","curation",{"id":37,"data":39,"filePath":41,"digest":42},{"name":40},"Curation","src/content/tags/curation.yaml","24442fb46b66b81d","ecology",{"id":43,"data":45,"file