는 끊임없이 자기 자신으로부터 벗어나게끔 한다. 내가 나라서, 나 자신이라는 감옥을 만들고 그곳에서 벗어나려 발버둥치다 끝내 포기한다. 나 자신이라는, 벗어날수 없는 감옥에서 무기력하게, 모든 것을 포기한채 웅크린 자세로 그것이 구원이든 파멸이든 이 상태의 마지막 순간, 끝을 기다린다. 산채로 죽는 것이다. 자살은 용기다. 나 자신이라는 감옥을 부술, 이 모든 것을 끝낼 용기와 의지가 도출해낸 행동의 결과다.","src/content/scraps/test.mdoc","c60903721f0153b5","tags",["Map",61,62,67,68,73,74,79,80,85,86,91,92,97,98,103,104,109,110,115,116,121,122,127,128,133,134,139,140,145,146,151,152,157,158],"archive",{"id":61,"data":63,"filePath":65,"digest":66},{"name":64},"Archive","src/content/tags/archive.yaml","96cbe3e8fc0c5c18","curation",{"id":67,"data":69,"filePath":71,"digest":72},{"name":70},"Curation","src/content/tags/curation.yaml","24442fb46b66b81d","ecology",{"id":73,"data":75,"filePath":77,"digest":78},{"name":76},"Ecology","src/content/tags/ecology.yaml","f4e6f0e203b81cdf","essay-film",{"id":79,"data":81,"filePath":83,"digest":84},{"name":82},"Essay Film","src/content/tags/essay-film.yaml","3e32b9547116d77f","event",{"id":85,"data":87,"filePath":89,"digest":90},{"name":88},"Event","src/content/tags/event.yaml","037ad031dec5db36","installation",{"id":91,"data":93,"filePath":95,"digest":96},{"name":94},"Installation","src/content/tags/installation.yaml","fe4ce9ee73c0c98f","interactive-media",{"id":97,"data":99,"filePath":101,"digest":102},{"name":100},"Interactive Media","src/content/tags/interactive-media.yaml","b0db62fe720aa0f4","painting",{"id":103,"data":105,"filePath":107,"digest":108},{"name":106},"Painting","src/content/tags/painting.yaml","25ba507816f7af53","performance",{"id":109,"data":111,"filePath":113,"digest":114},{"name":112},"Performance","src/content/tags/performance.yaml","3b6eee7178db3052","photography",{"id":115,"data":117,"filePath":119,"digest":120},{"name":118},"Photography","src/content/tags/photography.yaml","c0344240555459a9","public-intervention",{"id":121,"data":123,"filePath":125,"digest":126},{"name":124},"Public Intervention","src/content/tags/public-intervention.yaml","0515c92b8f50f6bb","sculpture",{"id":127,"da