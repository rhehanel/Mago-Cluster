 나 자신이라는, 벗어날수 없는 감옥에서 무기력하게, 모든 것을 포기한채 웅크린 자세로 그것이 구원이든 파멸이든 이 상태의 마지막 순간, 끝을 기다린다. 산채로 죽는 것이다. 자살은 용기다. 나 자신이라는 감옥을 부술, 이 모든 것을 끝낼 용기와 의지가 도출해낸 행동의 결과다.","src/content/scraps/test.mdoc","c60903721f0153b5","tags",["Map",60,61,66,67,72,73,78,79,84,85,90,91,96,97,102,103,108,109,114,115,120,121,126,127,132,133,138,139,144,145,150,151,156,157],"archive",{"id":60,"data":62,"filePath":64,"digest":65},{"name":63},"Archive","src/content/tags/archive.yaml","96cbe3e8fc0c5c18","curation",{"id":66,"data":68,"filePath":70,"digest":71},{"name":69},"Curation","src/content/tags/curation.yaml","24442fb46b66b81d","ecology",{"id":72,"data":74,"filePath":76,"digest":77},{"name":75},"Ecology","src/content/tags/ecology.yaml","f4e6f0e203b81cdf","essay-film",{"id":78,"data":80,"filePath":82,"digest":83},{"name":81},"Essay Film","src/content/tags/essay-film.yaml","3e32b9547116d77f","event",{"id":84,"data":86,"filePath":88,"digest":89},{"name":87},"Event","src/content/tags/event.yaml","037ad031dec5db36","installation",{"id":90,"data":92,"filePath":94,"digest":95},{"name":93},"Installation","src/content/tags/installation.yaml","fe4ce9ee73c0c98f","interactive-media",{"id":96,"data":98,"filePath":100,"digest":101},{"name":99},"Interactive Media","src/content/tags/interactive-media.yaml","b0db62fe720aa0f4","painting",{"id":102,"data":104,"filePath":106,"digest":107},{"name":105},"Painting","src/content/tags/painting.yaml","25ba507816f7af53","performance",{"id":108,"data":110,"filePath":112,"digest":113},{"name":111},"Performance","src/content/tags/performance.yaml","3b6eee7178db3052","photography",{"id":114,"data":116,"filePath":118,"digest":119},{"name":117},"Photography","src/content/tags/photography.yaml","c0344240555459a9","public-intervention",{"id":120,"data":122,"filePath":124,"digest":125},{"name":123},"Public Intervention","src/content/tags/public-intervention.yaml","0515c92b8f50f6bb","sculpture",{"id":126,"data":128,"filePath":130,"digest":131},{"name":129},"Sculpture","src/content/t